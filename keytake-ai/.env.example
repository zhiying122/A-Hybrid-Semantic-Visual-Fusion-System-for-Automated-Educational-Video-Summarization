# ═══════════════════════════════════════════════════════════════════
# KeyTake AI 環境變數設定範本
# 複製本檔案為 .env 並填入你的 API Key
#   copy .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ─── 語意評分模式（三選一）─────────────────────────────
# sbert  : 本地 Sentence-BERT 語意相似度（不需 API，適合離線使用）
# llm    : 使用選定 LLM backend 產生分析（外部服務或本機 Ollama）
# tfidf  : 純統計 TF-IDF（最快，無需任何外部資源）
SEMANTIC_SCORER_MODE=sbert

# ─── LLM 後端選擇（SEMANTIC_SCORER_MODE=llm 時才需要）──
# openai : OpenAI API（需 API Key，資料會送至遠端）
# groq   : Groq API（需 API Key，資料會送至遠端）
# ollama : 本機 Ollama 服務（需自行安裝及下載模型）
LLM_BACKEND=groq

# 學習素材生成預設跟隨 SEMANTIC_SCORER_MODE；若要單獨啟用遠端生成，明確設為 llm
# STUDY_MATERIALS_MODE=llm
# LLM_TIMEOUT_SEC=60

# ─── API Key 設定（依選擇的後端填寫對應的 Key）─────────
# OpenAI API Key（https://platform.openai.com/api-keys）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq API Key（https://console.groq.com/keys，免費申請）
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ollama 本地端點（安裝 Ollama 後預設就是這個位址）
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ─── Whisper 語音轉錄模式 ──────────────────────────────
# local  : 使用本機 Whisper 模型（離線，較慢但免費）
# remote : 使用 OpenAI Whisper API（需 OPENAI_API_KEY，音訊會送至遠端）
WHISPER_MODE=local

# ─── 系統工具路徑（選填，通常自動偵測即可）───────────────
# 若 FFmpeg / Tesseract 不在系統 PATH 中，可手動指定路徑
# FFMPEG_PATH=C:\ffmpeg\bin
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
